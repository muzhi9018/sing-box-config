{
  "outbound_rules": [
    {
      "target_tags": [
        "🐸 手动选择",
        "♻️ 自动选择"
      ],
      "match": "",
      "exclude": "ℹ️(?:官网|剩余|流量|套餐|免费|订阅|到期时间|全球直连|GB|Expire|Expire Date|Traffic|ExpireDate)"
    },
    {
      "target_tags": [
        "🌍 DNS"
      ],
      "match": "ℹ️^.*(自建|高级|家宽|HiNet).*",
      "exclude": ""
    },
    {
      "target_tags": [
        "🌍 运营-DNS"
      ],
      "match": "ℹ️^.*(高级|家宽|HiNet).*",
      "exclude": ""
    },
    {
      "target_tags": [
        "🏠 家宽代理"
      ],
      "match": "ℹ️.*(南山|台湾)",
      "exclude": "ℹ️(?:家宽|官网)"
    },
    {
      "target_tags": [
        "🇭🇰 香港手动"
      ],
      "match": "ℹ️.*(🇭🇰|HK|hk|香港|港|HongKong)",
